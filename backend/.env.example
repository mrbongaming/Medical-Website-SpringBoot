# Ví dụ chạy local với MySQL/MariaDB mặc định của XAMPP (cổng 3306)
DB_USERNAME=root
DB_PASSWORD=
HIBERNATE_DIALECT=org.hibernate.dialect.MariaDBDialect
CORE_DB_URL=jdbc:mysql://localhost:3306/antam_core?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
AUTH_DB_URL=jdbc:mysql://localhost:3306/antam_auth?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
NOTIFICATION_DB_URL=jdbc:mysql://localhost:3306/antam_notification?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh

# Giá trị dùng được cho local; phải thay bằng khóa ngẫu nhiên khi triển khai thật
JWT_SECRET=antam-local-jwt-secret-2026-change-before-production
JWT_EXPIRATION=PT8H
JWT_COOKIE_SECURE=false
INTERNAL_API_KEY=antam-local-internal-service-key-2026

# Cổng và địa chỉ nội bộ
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
CORE_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
AUTH_SERVICE_URL=http://localhost:8081
CORE_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# OAuth2 - tạo credential trong Google Cloud Console và Meta for Developers
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# Spring Email - Gmail yêu cầu App Password khi bật xác minh 2 bước
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=antam.demo@gmail.com
MAIL_PASSWORD=abcdefghijklmnop
MAIL_FROM=antam.demo@gmail.com

# VNPay sandbox - đăng ký merchant sandbox rồi điền credential được cấp
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/thanh-toan/vnpay/ket-qua
VNPAY_IPN_URL=http://localhost:8080/api/public/payments/vnpay/ipn
